# botslab-cloud configuration — copy to ".env" and fill in.
# NEVER commit your real .env (it is gitignored).
#
# How to obtain these values: see docs/SESSION-CAPTURE.md.
# ---------------------------------------------------------------------------

# --- Region / app constants (usually fine as-is) ---------------------------
BOTSLAB_REGION=na1            # na1 | ap1 | eu1 | eu2  (your account's region)
BOTSLAB_APPKEY=botslabadr     # public app identifier (sent in cleartext)
BOTSLAB_APPVER=2.31.2

# --- App signing secret (REQUIRED) -----------------------------------------
# A constant hard-coded inside the Android app. Extract it yourself from the
# decompiled APK (it lives next to the MD5 signer; see docs/PROTOCOL.md).
# NOT shipped with this repo on purpose.
BOTSLAB_SIGN_SECRET=

# --- Your installation / device identifiers (REQUIRED) ---------------------
BOTSLAB_M2=                   # app installation UUID (e.g. xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx)
BOTSLAB_PRODUCT_KEY=          # device product key (hex, from device/list)
BOTSLAB_DEVICE_NAME=          # device name / serial (from device/list)

# --- 360 account session (REQUIRED) — capture once from the app ------------
# URL-encoded cookie values exactly as the app sends them.
BOTSLAB_Q=                    # 360 "Q" cookie
BOTSLAB_T=                    # 360 "T" cookie
# cloudspirit session id — MANDATORY. Without it, /v1/iot/* returns code 1015.
# Format: botslab_<qid>_<login_ts>_<m2>_<hash>-<nodeid>
BOTSLAB_SID=

# --- Optional -------------------------------------------------------------
# BOTSLAB_CI_MODEL=sdk_gphone64_arm64
# BOTSLAB_CI_LANG=en-US
# BOTSLAB_CI_TZ=UTC-6
# BOTSLAB_TIMEOUT=12
# BOTSLAB_INSECURE=0          # set 1 to skip TLS verification (not recommended)
# BOTSLAB_ENV_FILE=.env       # alternate env file path
